<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this the bundle's own name is used to find the executable,
	     so renaming the application stops it starting. -->
	<key>CFBundleExecutable</key>
	<string>djv</string>
	<key>CFBundleIdentifier</key>
	<string>com.grizzlypeak3d.djv</string>
	<key>CFBundleName</key>
	<string>DJV</string>
	<key>CFBundleIconFile</key>
	<string>DJV.icns</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@DJV_VERSION_FULL@</string>
	<key>CFBundleVersion</key>
	<string>@DJV_VERSION_FULL@</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright Contributors to the DJV project.</string>
	<key>LSMinimumSystemVersion</key>
	<string>@DJV_MACOS_MINIMUM@</string>
	<key>NSHighResolutionCapable</key>
	<true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.video</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <!-- Reviews, under a type of their own: a Mac that knows it sends
             it with the file, which AirDrop needs to hand a review to DJV
             Studio on the iPad rather than to Files. -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>DJV Review</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.grizzlypeak3d.djv.review</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>aac</string>
                <string>aiff</string>
                <string>flac</string>
                <string>m4a</string>
                <string>m4v</string>
                <string>mov</string>
                <string>mp3</string>
                <string>mp4</string>
                <string>mxf</string>
                <string>opus</string>
                <string>wav</string>
                <string>webm</string>
                <string>y4m</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>bmp</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>bw</string>
                <string>rgb</string>
                <string>rgba</string>
                <string>sgi</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>cin</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>dpx</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>exr</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>jpeg</string>
                <string>jpg</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>png</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>otio</string>
                <string>otioz</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>ppm</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>psd</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>tga</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>tif</string>
                <string>tiff</string>
            </array>
        </dict>
@DJV_MACOS_USD_DOCUMENT_TYPES@    </array>
    <!-- The same type the iPad's DJV Studio declares. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.grizzlypeak3d.djv.review</string>
            <key>UTTypeDescription</key>
            <string>DJV Review</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>djvr</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
