{
  "shots": [
    {
      "id": "notes-tool",
      "strict": true,
      "window": { "w": 900, "h": 600 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "tool": "Notes" },
        { "expect": "Notes.Edit", "visible": true },
