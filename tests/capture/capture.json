{
  "shots": [
    {
      "id": "review-pen",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "frame": 5 },
        { "tool": "Review" },
        { "expect": "Review.Pen", "checked": false },
        { "expect": "Review.Undo", "enabled": false },
        { "click": "Review.Pen" },
        { "expect": "Review.Pen", "checked": true },
        { "expect": "Review.Eraser", "checked": false },
        { "drag": [
            ["MainWindow.Viewport", 0.3, 0.6],
            ["MainWindow.Viewport", 0.4, 0.4],
            ["MainWindow.Viewport", 0.5, 0.6],
            ["MainWindow.Viewport", 0.6, 0.4] ] },
        { "expect": "Review.Undo", "enabled": true },
        { "expect": "Review.Redo", "enabled": false },
        { "click": "Review.Undo" },
        { "expect": "Review.Undo", "enabled": false },
        { "expect": "Review.Redo", "enabled": true },
        { "click": "Review.Redo" },
        { "expect": "Review.Undo", "enabled": true },
        { "click": "Review.Eraser" },
        { "expect": "Review.Pen", "checked": false },
        { "expect": "Review.Eraser", "checked": true },
        { "click": "Review.Eraser" },
        { "expect": "Review.Eraser", "checked": false }
      ]
    },
    {
      "id": "review-pen-mouse-tool",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "frame": 5 },
        { "tool": "Review" },
        { "command": "View/MouseTool_1", "args": { "value": true } },
        { "click": "Review.Pen" },
        { "expect": "Review.Pen", "checked": true },
        { "drag": [
            ["MainWindow.Viewport", 0.3, 0.6],
            ["MainWindow.Viewport", 0.5, 0.4],
            ["MainWindow.Viewport", 0.6, 0.6] ] },
        { "expect": "Review.Undo", "enabled": true },
        { "command": "View/MouseTool_2", "args": { "value": true } },
        { "expect": "Review.Pen", "checked": false },
        { "click": "Review.Pen" },
        { "expect": "Review.Pen", "checked": true }
      ]
    },
    {
      "id": "toolbar-fits",
      "strict": true,
      "window": { "w": 1920, "h": 600 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "expect": "ToolBarRow.Overflow", "visible": false },
        { "expect": "View.MouseTool", "checked": false },
        { "click": "View.MouseTool" },
        { "expect": "View.MouseTool", "checked": true },
        { "click": "View.MouseTool" },
        { "expect": "View.MouseTool", "checked": false },
        { "expect": "Compare.Mode", "checked": false },
        { "click": "Compare.Mode" },
        { "expect": "Compare.Mode", "checked": true },
        { "click": "Compare.Mode" },
        { "expect": "Compare.Mode", "checked": false }
      ]
    },
    {
      "id": "toolbar-overflow",
      "strict": true,
      "window": { "w": 480, "h": 600 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "expect": "ToolBarRow.Overflow", "visible": true },
        { "click": "ToolBarRow.Overflow" }
      ]
    },
    {
      "id": "review-constrain",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "frame": 4 },
        { "tool": "Review" },
        { "expect": "Review.Constrain", "checked": false },
        { "click": "Review.Constrain" },
        { "expect": "Review.Constrain", "checked": true },
        { "click": "Review.Rectangle" },
        { "drag": [["MainWindow.Viewport", 0.2, 0.3], ["MainWindow.Viewport", 0.45, 0.5]] },
        { "expect": "Review.Undo", "enabled": true },
        { "command": "Review/Constrain", "args": { "value": false } },
        { "expect": "Review.Constrain", "checked": false },
        { "click": "Review.Ellipse" },
        { "drag": [["MainWindow.Viewport", 0.55, 0.3], ["MainWindow.Viewport", 0.8, 0.5]], "hold": "Shift" },
        { "expect": "Review.Undo", "enabled": true }
      ]
    },
    {
      "id": "review-shapes",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "frame": 4 },
        { "tool": "Review" },
        { "click": "Review.Rectangle" },
        { "expect": "Review.Rectangle", "checked": true },
        { "drag": [["MainWindow.Viewport", 0.2, 0.3], ["MainWindow.Viewport", 0.45, 0.6]] },
        { "expect": "Review.Undo", "enabled": true },
        { "click": "Review.Arrow" },
        { "expect": "Review.Rectangle", "checked": false },
        { "expect": "Review.Arrow", "checked": true },
        { "drag": [["MainWindow.Viewport", 0.55, 0.7], ["MainWindow.Viewport", 0.75, 0.4]] },
        { "click": "Review.Text" },
        { "expect": "Review.Text", "checked": true },
        { "click": ["MainWindow.Viewport", 0.5, 0.2] },
        { "text": "Check the sky" },
        { "key": "Return" },
        { "click": "Review.Select" },
        { "expect": "Review.Text", "checked": false },
        { "expect": "Review.Select", "checked": true },
        { "click": ["MainWindow.Viewport", 0.2, 0.45] },
        { "key": "Delete" },
        { "expect": "Review.Undo", "enabled": true }
      ]
    },
    {
      "id": "press-release",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "tool": "Review" },
        { "press": "Review.Pen" },
        { "expect": "Review.Pen", "checked": false },
        { "release": "Review.Pen" },
        { "expect": "Review.Pen", "checked": true }
      ]
    },
    {
      "id": "marker-add-collapsed",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "frame": 3 },
        { "tool": "Review", "collapse": "Markers" },
        { "expect": "Review.MarkerEdit", "visible": false },
        { "command": "Review/AddNote" },
        { "expect": "Review.MarkerEdit", "visible": true }
      ]
    },
    {
      "id": "marker-edit",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "frame": 5 },
        { "tool": "Review" },
        { "markers": [
            { "frame": 1, "text": "Exposure jumps between these frames." },
            { "range": [3, 7], "name": "Train pass", "text": "Hold the timing through the platform." } ] },
        { "expect": "Review.MarkerEdit", "visible": false },
        { "click": "Review.Marker1", "count": 2 },
        { "expect": "Review.MarkerEdit", "visible": true },
        { "key": "Escape" },
        { "expect": "Review.MarkerEdit", "visible": false }
      ]
    },
    {
      "id": "recent-files",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "open": "etc/SampleData/ColorPatternPortrait.png" },
        { "command": "File/RecentFiles" },
        { "expect": "RecentFiles.Search", "visible": true },
        { "expect": "RecentFiles.Count", "text": "2 files" },
        { "text": "portrait" },
        { "expect": "RecentFiles.Count", "text": "1 of 2 files" },
        { "key": "Return" },
        { "expect": "RecentFiles.Search", "visible": false },
        { "command": "File/RecentFiles" },
        { "text": "portrait" },
        { "key": "Escape" },
        { "expect": "RecentFiles.Count", "text": "2 files" },
        { "expect": "RecentFiles.Search", "visible": true },
        { "key": "Escape" },
        { "expect": "RecentFiles.Search", "visible": false },
        { "command": "File/RecentFiles" },
        { "click": "RecentFiles.Clear" },
        { "expect": "RecentFiles.Count", "text": "0 files" },
        { "expect": "RecentFiles.Clear", "enabled": false }
      ]
    },
    {
      "id": "recent-several",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "open": [
            "etc/SampleData/ColorPatternPortrait.png",
            "etc/SampleData/Cubes.0001.exr",
            "etc/SampleData/ColorPattern.png" ] },
        { "command": "File/RecentFiles" },
        { "expect": "RecentFiles.Count", "text": "3 files" }
      ]
    },
    {
      "id": "recent-folder",
      "requires": ["TLRENDER_FFMPEG"],
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "open": "etc/SampleData" },
        { "command": "File/RecentFiles" },
        { "expect": "RecentFiles.Count", "text": "2 files" },
        { "text": "etc" },
        { "key": "Escape" },
        { "expect": "RecentFiles.Count", "text": "2 files" }
      ]
    },
    {
      "id": "shortcuts-search",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "tool": "Settings", "expand": ["Shortcuts"] },
        { "click": "Shortcuts.Search" },
        { "text": "Playback" },
        { "expect": "Shortcuts.Search", "contains": "Playback" }
      ]
    },
    {
      "id": "playback-keys",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "frame": 2 },
        { "expect": "Playback.CurrentFrame", "contains": "00:00:00:02" },
        { "key": "Right" },
        { "expect": "Playback.CurrentFrame", "contains": "00:00:00:03" },
        { "key": "Left" },
        { "key": "Left" },
        { "expect": "Playback.CurrentFrame", "contains": "00:00:00:01" },
        { "key": "End" },
        { "expect": "Playback.CurrentFrame", "contains": "00:00:00:09" },
        { "key": "Home" },
        { "expect": "Playback.CurrentFrame", "contains": "00:00:00:00" }
      ]
    },
    {
      "id": "compare-mode",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "open": "etc/SampleData/ColorPattern.png" },
        { "open": "etc/SampleData/Counter.#.png" },
        { "tool": "Files", "expand": ["Compare"] },
        { "expect": "Files.CompareMode", "text": "None" },
        { "click": "Files.CompareMode" },
        { "key": "Down" },
        { "key": "Return" },
        { "expect": "Files.CompareMode", "text": "B" }
      ]
    },
    {
      "id": "hold-frame",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "command": "Playback/Seek", "args": { "frame": 3 } },
        { "wait": 0.5 },
        { "command": "Compare/HoldFrame" },
        { "command": "Playback/Seek", "args": { "frame": 9 } },
        { "wait": 1.0 },
        { "expect": "View.Held", "contains": "B: held Counter.0.png 00:00:00:03" },
        { "command": "Compare/ClearHeld" },
        { "expect": "View.Held", "visible": false }
      ]
    },
    {
      "id": "export-size",
      "strict": true,
      "window": { "w": 1000, "h": 700 },
      "setup": [
        { "open": "etc/SampleData/ColorPatternPortrait.png" },
        { "tool": "Export" },
        { "tab": "Movie" },
        { "expect": "Export.Size", "text": "300 x 400" },
        { "expect": "Export.Width", "visible": false },
        { "click": "Export.RenderSize" },
        { "key": "End" },
        { "key": "Up" },
        { "key": "Up" },
        { "key": "Return" },
        { "expect": "Export.RenderSize", "text": "4096" },
        { "expect": "Export.Size", "text": "4096 x 5462" },
        { "tab": "Sequence" },
        { "expect": "Export.Size", "text": "4096 x 5461" },
        { "click": "Export.RenderSize" },
        { "key": "End" },
        { "key": "Up" },
        { "key": "Return" },
        { "expect": "Export.RenderSize", "text": "Width" },
        { "expect": "Export.Width", "visible": true },
        { "expect": "Export.Height", "visible": false },
        { "click": ["Export.Width", 0.1, 0.5] },
        { "text": "1000" },
        { "key": "Return" },
        { "expect": "Export.Size", "text": "x 1333" },
        { "tab": "Movie" },
        { "expect": "Export.Size", "text": "x 1334" },
        { "click": "Export.RenderSize" },
        { "key": "End" },
        { "key": "Return" },
        { "expect": "Export.RenderSize", "text": "Custom" },
        { "expect": "Export.Size", "visible": false },
        { "expect": "Export.Height", "visible": true },
        { "click": ["Export.Height", 0.1, 0.5] },
        { "text": "439" },
        { "key": "Return" },
        { "expect": "Export.Width", "contains": "1000" },
        { "expect": "Export.Height", "contains": "439" },
        { "tab": "Sequence" },
        { "expect": "Export.Height", "contains": "439" }
      ]
    },
    {
      "id": "view-dither",
      "strict": true,
      "window": { "w": 1000, "h": 700 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "tool": "View", "expand": ["Options"] },
        { "expect": "View.Options.Dither", "checked": false },
        { "click": "View.Options.Dither" },
        { "expect": "View.Options.Dither", "checked": true }
      ]
    },
    {
      "id": "tooltip",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "crop": "MainWindow.Tools",
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "tool": "Review" },
        { "tooltip": "Review.Pen" }
      ]
    },
    {
      "id": "tour",
      "strict": true,
      "window": { "w": 1000, "h": 700, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "command": "Help/Tour" },
        { "expect": "Tour.Prev", "enabled": false },
        { "expect": "Tour.Title", "contains": "Welcome to" },
        { "click": "Tour.Next" },
        { "expect": "Tour.Prev", "enabled": true },
        { "expect": "Tour.Title", "text": "The view" },
        { "click": "Tour.Next" },
        { "expect": "Tour.Title", "text": "Files" },
        { "click": "Tour.Prev" },
        { "expect": "Tour.Title", "text": "The view" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "expect": "Tour.Title", "text": "Playback" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "expect": "Tour.Title", "text": "Tools" },
        { "click": "Tour.Next" },
        { "expect": "Tour.Title", "text": "Cache settings" },
        { "expect": "Settings.Cache", "visible": true }
      ]
    },
    {
      "id": "tour-done",
      "requires": ["TLRENDER_FFMPEG_PLUGIN"],
      "strict": true,
      "window": { "w": 1000, "h": 700, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "command": "Help/Tour" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "click": "Tour.Next" },
        { "expect": "Tour.Title", "text": "That is the tour" },
        { "expect": "Tour.Next", "text": "Done" },
        { "expect": "Tour.Close", "visible": false },
        { "click": "Tour.Next" },
        { "expect": "Tour.Title", "visible": false },
        { "expect": "MainWindow.Tools", "visible": false }
      ]
    },
    {
      "id": "hud-lut",
      "strict": true,
      "requires": ["TLRENDER_OCIO"],
      "window": { "w": 900, "h": 500 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "view": { "hud": { "enabled": true, "items": { "LUT": "Top Left" } } } },
        { "expect": "View.HUD.LUT", "text": "LUT: -" },
        { "lut": "deps/tlRender/etc/SampleData/LUT_SRGB_256.lut" },
        { "expect": "View.HUD.LUT", "text": "LUT: LUT_SRGB_256.lut" }
      ]
    },
    {
      "id": "present-close",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "command": "Window/PresentMode", "args": { "value": true } },
        { "expect": "MainWindow.MenuBar", "visible": false },
        { "command": "File/Close" },
        { "expect": "MainWindow.MenuBar", "visible": true }
      ]
    },
    {
      "id": "tour-present",
      "strict": true,
      "window": { "w": 1000, "h": 700, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "command": "Window/PresentMode", "args": { "value": true } },
        { "command": "Help/Tour" },
        { "expect": "Tour.Title", "contains": "Welcome to" },
        { "click": "Tour.Next" },
        { "expect": "Tour.Title", "text": "The view" },
        { "click": "Tour.Next" },
        { "wait": 2.0 },
        { "expect": "Tour.Title", "text": "That is the tour" },
        { "expect": "Tour.Next", "text": "Done" },
        { "click": "Tour.Next" },
        { "expect": "Tour.Title", "visible": false }
      ]
    }
  ]
}
