    {
      "id": "marker-time-step",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "tool": "Review" },
        { "markers": [
            { "range": [1, 3], "name": "Train pass", "text": "Hold the timing." },
            { "frame": 3, "text": "Late." } ] },
        { "click": "Review.Marker0", "count": 2 },
        { "expect": "Review.MarkerEdit", "visible": true },
        { "click": ["Review.MarkerStart", 0.96, 0.25] },
        { "expect": "Review.MarkerEdit", "visible": true },
        { "expect": "Review.MarkerStart", "contains": "00:00:00:02" },
        { "expect": "Review.MarkerEnd", "contains": "00:00:00:04" },
        { "click": "Review.MarkerEnd" },
        { "key": "Up" },
        { "key": "Up" },
        { "expect": "Review.MarkerEnd", "contains": "00:00:00:06" },
        { "click": "Review.MarkerStart" },
        { "text": "00:00:00:09" },
        { "key": "Return" },
        { "expect": "Review.MarkerStart", "contains": "00:00:00:05" },
        { "expect": "Review.MarkerEnd", "contains": "00:00:00:09" },
        { "key": "Down" },
        { "expect": "Review.MarkerStart", "contains": "00:00:00:04" },
        { "expect": "Review.MarkerEnd", "contains": "00:00:00:08" },
        { "press": ["Review.MarkerStart", 0.96, 0.75] },
        { "wait": 1.0 },
        { "release": ["Review.MarkerStart", 0.96, 0.75] },
        { "expect": "Review.MarkerEdit", "visible": true },
        { "expect": "Review.MarkerStart", "contains": "00:00:00:0" },
        { "click": "MainWindow.Viewport" },
        { "expect": "Review.MarkerEdit", "visible": false }
      ]
    },
