{
  "shots": [
    {
      "id": "review-pen",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "frame": 5 },
        { "tool": "Review" },
        { "expect": "Review.Pen", "checked": false },
        { "expect": "Review.Undo", "enabled": false },
        { "click": "Review.Pen" },
        { "expect": "Review.Pen", "checked": true },
        { "expect": "Review.Eraser", "checked": false },
        { "drag": [
            ["MainWindow.Viewport", 0.3, 0.6],
            ["MainWindow.Viewport", 0.4, 0.4],
            ["MainWindow.Viewport", 0.5, 0.6],
            ["MainWindow.Viewport", 0.6, 0.4] ] },
        { "expect": "Review.Undo", "enabled": true },
        { "expect": "Review.Redo", "enabled": false },
        { "click": "Review.Undo" },
        { "expect": "Review.Undo", "enabled": false },
        { "expect": "Review.Redo", "enabled": true },
        { "click": "Review.Redo" },
        { "expect": "Review.Undo", "enabled": true },
        { "click": "Review.Eraser" },
        { "expect": "Review.Pen", "checked": false },
        { "expect": "Review.Eraser", "checked": true },
        { "click": "Review.Eraser" },
        { "expect": "Review.Eraser", "checked": false }
      ]
    },
    {
      "id": "press-release",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "tool": "Review" },
        { "press": "Review.Pen" },
        { "expect": "Review.Pen", "checked": false },
        { "release": "Review.Pen" },
        { "expect": "Review.Pen", "checked": true }
      ]
    },
    {
      "id": "marker-edit",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "frame": 5 },
        { "tool": "Review" },
        { "markers": [
            { "frame": 1, "text": "Exposure jumps between these frames." },
            { "range": [3, 7], "name": "Train pass", "text": "Hold the timing through the platform." } ] },
        { "expect": "Review.MarkerEdit", "visible": false },
        { "click": "Review.Marker1", "count": 2 },
        { "expect": "Review.MarkerEdit", "visible": true },
        { "key": "Escape" },
        { "expect": "Review.MarkerEdit", "visible": false }
      ]
    },
    {
      "id": "recent-files",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "open": "etc/SampleData/Charlie.jpg" },
        { "command": "File/RecentFiles" },
        { "expect": "RecentFiles.Search", "visible": true },
        { "expect": "RecentFiles.Count", "text": "2 files" },
        { "text": "charl" },
        { "expect": "RecentFiles.Count", "text": "1 of 2 files" },
        { "key": "Return" },
        { "expect": "RecentFiles.Search", "visible": false },
        { "command": "File/RecentFiles" },
        { "text": "charl" },
        { "key": "Escape" },
        { "expect": "RecentFiles.Count", "text": "2 files" },
        { "expect": "RecentFiles.Search", "visible": true },
        { "key": "Escape" },
        { "expect": "RecentFiles.Search", "visible": false },
        { "command": "File/RecentFiles" },
        { "click": "RecentFiles.Clear" },
        { "expect": "RecentFiles.Count", "text": "0 files" },
        { "expect": "RecentFiles.Clear", "enabled": false }
      ]
    },
    {
      "id": "recent-folder",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "open": "etc/SampleData" },
        { "command": "File/RecentFiles" },
        { "expect": "RecentFiles.Count", "text": "2 files" },
        { "text": "etc" },
        { "key": "Escape" },
        { "expect": "RecentFiles.Count", "text": "2 files" }
      ]
    },
    {
      "id": "shortcuts-search",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "tool": "Settings", "expand": ["Shortcuts"] },
        { "click": "Shortcuts.Search" },
        { "text": "Playback" },
        { "expect": "Shortcuts.Search", "contains": "Playback" }
      ]
    },
    {
      "id": "playback-keys",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "frame": 2 },
        { "expect": "Playback.CurrentFrame", "contains": "00:00:00:02" },
        { "key": "Right" },
        { "expect": "Playback.CurrentFrame", "contains": "00:00:00:03" },
        { "key": "Left" },
        { "key": "Left" },
        { "expect": "Playback.CurrentFrame", "contains": "00:00:00:01" },
        { "key": "End" },
        { "expect": "Playback.CurrentFrame", "contains": "00:00:00:09" },
        { "key": "Home" },
        { "expect": "Playback.CurrentFrame", "contains": "00:00:00:00" }
      ]
    },
    {
      "id": "compare-mode",
      "strict": true,
      "window": { "w": 1000, "h": 600 },
      "setup": [
        { "open": "etc/SampleData/ColorPattern.png" },
        { "open": "etc/SampleData/Counter.#.png" },
        { "tool": "Files", "expand": ["Compare"] },
        { "expect": "Files.CompareMode", "text": "None" },
        { "click": "Files.CompareMode" },
        { "key": "Down" },
        { "key": "Return" },
        { "expect": "Files.CompareMode", "text": "B" }
      ]
    },
    {
      "id": "export-size",
      "strict": true,
      "window": { "w": 1000, "h": 700 },
      "setup": [
        { "open": "etc/SampleData/ColorPatternPortrait.png" },
        { "tool": "Export" },
        { "tab": "Movie" },
        { "expect": "Export.Size", "text": "300 x 400" },
        { "expect": "Export.Width", "visible": false },
        { "click": "Export.RenderSize" },
        { "key": "End" },
        { "key": "Up" },
        { "key": "Up" },
        { "key": "Return" },
        { "expect": "Export.RenderSize", "text": "4096" },
        { "expect": "Export.Size", "text": "4096 x 5462" },
        { "tab": "Sequence" },
        { "expect": "Export.Size", "text": "4096 x 5461" },
        { "click": "Export.RenderSize" },
        { "key": "End" },
        { "key": "Up" },
        { "key": "Return" },
        { "expect": "Export.RenderSize", "text": "Width" },
        { "expect": "Export.Width", "visible": true },
        { "expect": "Export.Height", "visible": false },
        { "click": ["Export.Width", 0.1, 0.5] },
        { "text": "1000" },
        { "key": "Return" },
        { "expect": "Export.Size", "text": "x 1333" },
        { "tab": "Movie" },
        { "expect": "Export.Size", "text": "x 1334" },
        { "click": "Export.RenderSize" },
        { "key": "End" },
        { "key": "Return" },
        { "expect": "Export.RenderSize", "text": "Custom" },
        { "expect": "Export.Size", "visible": false },
        { "expect": "Export.Height", "visible": true },
        { "click": ["Export.Height", 0.1, 0.5] },
        { "text": "439" },
        { "key": "Return" },
        { "expect": "Export.Width", "contains": "1000" },
        { "expect": "Export.Height", "contains": "439" },
        { "tab": "Sequence" },
        { "expect": "Export.Height", "contains": "439" }
      ]
    },
    {
      "id": "tooltip",
      "strict": true,
      "window": { "w": 1000, "h": 600, "splitter2": 0.55 },
      "crop": "MainWindow.Tools",
      "setup": [
        { "open": "etc/SampleData/Counter.#.png" },
        { "tool": "Review" },
        { "tooltip": "Review.Pen" }
      ]
    }
  ]
}
